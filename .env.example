# Google Drive Configuration
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_TOKEN_FILE=data/google_token.json

# YouTube Configuration
# OAuth Desktop client JSON downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRET_FILE=data/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=data/youtube_token.json
YOUTUBE_PRIVACY_STATUS=private

# Application Behavior
DRY_RUN=true

# AI Providers. Offline TTS uses Windows speech voices and needs no API key.
STORY_PROVIDER=mock
TTS_PROVIDER=offline
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=300
# Set in the Local AI clipper page to an already-installed local model folder.
FASTER_WHISPER_MODEL_PATH=
OPENAI_STORY_MODEL=gpt-4o-mini
ANTHROPIC_STORY_MODEL=claude-sonnet-4-20250514
GEMINI_STORY_MODEL=gemini-3.8-flash
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Directories
OUTPUT_DIR=data/output
INPUT_DIR=data/input
TEMP_DIR=data/temp

# Database
DATABASE_PATH=data/automation.sqlite3

# Caption Configuration
CAPTION_MAX_LENGTH=100
CAPTION_STYLE=dark_humor
CAPTION_FONT_SIZE=48
CAPTION_PADDING=20
CAPTION_BOG_COLOR=0,0,0,200
CAPTION_TEXT_COLOR=255,255,255,255

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/automation.log

# Processing
MAX_FILE_SIZE_MB=500
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,webp
SUPPORTED_VIDEO_FORMATS=mp4,mov,webm,mkv

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
